<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/rows" android:textSize="20sp" />
    <TextView android:id="@+id/txtRows" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="0"
        android:textColor="@color/primary" android:textSize="72sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/btnRemoveRow" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/remove_row" />
        <Button android:id="@+id/btnAddRow" style="@style/Widget.AppCompat.Button.Colored"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/add_row" />
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="32dp" android:text="@string/stitches" android:textSize="20sp" />
    <TextView android:id="@+id/txtStitches" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="0"
        android:textColor="@color/primary" android:textSize="72sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/btnRemoveStitch" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/remove_stitch" />
        <Button android:id="@+id/btnAddStitch" style="@style/Widget.AppCompat.Button.Colored"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/add_stitch" />
    </LinearLayout>

    <Button android:id="@+id/btnReset" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="32dp" android:text="@string/reset" />
</LinearLayout>
